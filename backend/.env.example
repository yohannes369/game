# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=auth_system

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_to_something_long_and_random
JWT_REFRESH_SECRET=change_this_refresh_secret_to_something_else_long_and_random
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Default admin (used by `npm run seed`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_FULLNAME=System Administrator
